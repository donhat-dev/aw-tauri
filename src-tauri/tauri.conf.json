{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActivityWatch",
  "version": "0.1.0",
  "identifier": "net.activitywatch.tauri",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/aw-watcher-afk/**/*": "aw-watcher-afk/",
      "../resources/aw-watcher-window/**/*": "aw-watcher-window/",
      "../resources/aw-watcher-input/**/*": "aw-watcher-input/"
    }
  }
}
